@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Manage Books";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Books</h1>
            <p class="text-muted">Add, view, update, and manage library book records.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create New Book
        </a>
    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow-sm h-100 border-0">

                    <img src="@item.CoverImageUrl"
                         class="card-img-top"
                         style="height: 350px; object-fit: cover;" />

                    <div class="card-body">

                        <h5 class="fw-bold">@item.Title</h5>

                        <p class="text-muted mb-1">@item.Author</p>

                        <p>
                            <span class="badge bg-secondary">
                                @item.Genre
                            </span>
                        </p>

                        <p class="small text-muted">
                            Available Copies: @item.AvailableCopies / @item.TotalCopies
                        </p>

                        @if (item.AvailabilityStatus == "Available")
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Borrowed</span>
                        }

                        <div class="mt-3 d-flex gap-2">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                View
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-danger btn-sm">
                                Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>