@{
    ViewData["Title"] = "Library Notifications";
}

<div class="container mt-5">

    <div class="notification-header mb-5">
        <h1 class="fw-bold">Library Notifications</h1>

        <p class="text-muted">
            Stay updated with important library alerts, overdue reminders,
            reservation approvals, and newly added books.
        </p>
    </div>

    <div class="card shadow-sm border-0 p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-danger">Overdue Reminder</h4>

                <p class="mb-0">
                    Your borrowed book <strong>Clean Code</strong>
                    is due in 2 days.
                </p>
            </div>

            <span class="badge bg-danger p-2">
                Important
            </span>
        </div>

    </div>

    <div class="card shadow-sm border-0 p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-success">Reservation Approved</h4>

                <p class="mb-0">
                    Your reservation for
                    <strong>The Great Gatsby</strong>
                    has been approved.
                </p>
            </div>

            <span class="badge bg-success p-2">
                Approved
            </span>
        </div>

    </div>

    <div class="card shadow-sm border-0 p-4 mb-4">

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="text-primary">New Books Added</h4>

                <p class="mb-0">
                    New programming and software engineering books
                    have been added to the KOI Library collection.
                </p>
            </div>

            <span class="badge bg-primary p-2">
                New
            </span>
        </div>

    </div>

</div>