@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Catalogue";
}

@if (TempData["BorrowLimitMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
        <strong>Borrowing Notice:</strong> @TempData["BorrowLimitMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="text-center mb-5">

    <h1 class="fw-bold">KOI Library Catalogue</h1>

    <p class="text-muted">
        Browse books available in the KOI digital library system
    </p>

    <form asp-controller="Home"
          asp-action="Catalogue"
          method="get"
          class="mt-4">

        <div class="input-group w-50 mx-auto">

            <input type="text"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Search books by title, author, genre, or ISBN..." />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-controller="Home"
               asp-action="Catalogue"
               class="btn btn-outline-secondary">
                Clear
            </a>

        </div>

    </form>

</div>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

            <div class="card shadow-sm border-0 h-100 book-card">

                <img src="@item.CoverImageUrl"
                     class="card-img-top book-image"
                     style="height: 260px; object-fit: cover;" />

                <div class="card-body">

                    <h5 class="fw-bold">
                        @item.Title
                    </h5>

                    <p class="text-muted">
                        @item.Author
                    </p>

                    <p>
                        <span class="badge bg-secondary">
                            @item.Genre
                        </span>
                    </p>

                    <p class="small text-muted">
                        Available Copies:
                        @item.AvailableCopies / @item.TotalCopies
                    </p>

                    @if (item.AvailableCopies > 0)
                    {
                        <span class="badge bg-success">
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Borrowed
                        </span>
                    }

                    <div class="mt-3 d-grid gap-2">

                        @if (item.AvailableCopies > 0)
                        {
                            <form asp-controller="BorrowTransactions"
                                  asp-action="CreateFromCatalogue"
                                  method="post"
                                  onsubmit="return showConfirmModal(this,
                                  'Confirm Borrowing',
                                  'Are you sure you want to borrow this book?',
                                  'Yes, Borrow')">

                                <input type="hidden"
                                       name="bookId"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    Borrow
                                </button>

                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary w-100" disabled>
                                Not Available
                            </button>
                        }

                        <form asp-controller="BorrowTransactions"
                              asp-action="ReserveFromCatalogue"
                              method="post"
                              onsubmit="return showConfirmModal(this,
                              'Confirm Reservation',
                              'Are you sure you want to reserve this book?',
                              'Yes, Reserve')">

                            <input type="hidden"
                                   name="bookId"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-warning w-100">
                                Reserve
                            </button>

                        </form>

                        <a asp-controller="Books"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary w-100">
                            Details
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>