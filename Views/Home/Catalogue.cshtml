@{
    ViewData["Title"] = "Catalogue";
}

<div class="text-center mb-5">

    <h1 class="fw-bold">KOI Library Catalogue</h1>

    <p class="text-muted">
        Browse books available in the KOI digital library system
    </p>

    <input type="text"
           class="form-control w-50 mx-auto mt-4"
           placeholder="Search books by title, author, or genre..." />

</div>

<div class="row">

    <div class="col-md-4 mb-4">

        <div class="card shadow-sm border-0 h-100">

            <img src="https://images.unsplash.com/photo-1544947950-fa07a98d237f"
                 class="card-img-top"
                 style="height: 350px; object-fit: cover;" />

            <div class="card-body">

                <h5 class="fw-bold">Clean Code</h5>

                <p class="text-muted">
                    Robert C. Martin
                </p>

                <span class="badge bg-success">
                    Available
                </span>

                <div class="mt-3 d-flex gap-2">

                    <button class="btn btn-primary btn-sm">
                        Borrow
                    </button>

                    <button class="btn btn-outline-primary btn-sm">
                        Details
                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4 mb-4">

        <div class="card shadow-sm border-0 h-100">

            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794"
                 class="card-img-top"
                 style="height: 350px; object-fit: cover;" />

            <div class="card-body">

                <h5 class="fw-bold">The Great Gatsby</h5>

                <p class="text-muted">
                    F. Scott Fitzgerald
                </p>

                <span class="badge bg-danger">
                    Borrowed
                </span>

                <div class="mt-3 d-flex gap-2">

                    <button class="btn btn-secondary btn-sm">
                        Reserve
                    </button>

                    <button class="btn btn-outline-primary btn-sm">
                        Details
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>