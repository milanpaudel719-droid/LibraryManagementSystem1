@{
    ViewData["Title"] = "Home Page";
}

<section class="library-hero">
    <div class="hero-content">
        <h1>Discover, Borrow and Manage Books Online</h1>
        <p>
            KOI Library Management System provides a modern platform for librarians and members
            to manage books, borrowing records, feedback, and library services efficiently.
        </p>

        <div class="hero-buttons">
            <a class="btn btn-light" asp-controller="Home" asp-action="Catalogue">Browse Collection</a>
            <a class="btn btn-outline-light" asp-controller="BorrowTransactions" asp-action="Index">View My Borrowings</a>
        </div>
    </div>
</section>

<section class="quick-stats">
    <div class="stat-card">
        <h3>500+</h3>
        <p>Books Managed</p>
    </div>

    <div class="stat-card">
        <h3>100+</h3>
        <p>Active Members</p>
    </div>

    <div class="stat-card">
        <h3>24/7</h3>
        <p>Online Access</p>
    </div>

    <div class="stat-card">
        <h3>Secure</h3>
        <p>Library Records</p>
    </div>
</section>
<section class="mt-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold display-5">Explore Library Highlights</h2>
        <p class="text-muted fs-5">
            Automatically generated from library records and borrowing activity.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-lg-3 col-md-6">
            <div class="feature-card h-100 p-4">
                <h4 class="fw-bold text-primary mb-3">📚 New Arrivals</h4>

                @foreach (var book in ViewBag.NewArrivals)
                {
                    <div class="mb-3 border-bottom pb-2">
                        <strong>@book.Title</strong>
                        <p class="text-muted mb-1">@book.Author</p>
                    </div>
                }

                <a asp-controller="Home" asp-action="Catalogue" class="btn btn-primary btn-sm">
                    View New Books
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="feature-card h-100 p-4">
                <h4 class="fw-bold text-danger mb-3">🔥 Most Borrowed</h4>

                @foreach (var book in ViewBag.MostBorrowed)
                {
                    <div class="mb-3 border-bottom pb-2">
                        <strong>@book.BookTitle</strong>
                        <p class="text-muted mb-1">Borrowed @book.BorrowCount times</p>
                    </div>
                }

                <a asp-controller="Home" asp-action="Catalogue" class="btn btn-danger btn-sm">
                    View Popular
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="feature-card h-100 p-4">
                <h4 class="fw-bold text-warning mb-3">⭐ Recommended</h4>

                @foreach (var book in ViewBag.RecommendedBooks)
                {
                    <div class="mb-3 border-bottom pb-2">
                        <strong>@book.Title</strong>
                        <p class="text-muted mb-1">@book.Author</p>
                    </div>
                }

                <a asp-controller="Home" asp-action="Catalogue" class="btn btn-warning btn-sm">
                    View Recommended
                </a>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="feature-card h-100 p-4">
                <h4 class="fw-bold text-success mb-3">✅ Available Books</h4>

                @foreach (var book in ViewBag.AvailableBooks)
                {
                    <div class="mb-3 border-bottom pb-2">
                        <strong>@book.Title</strong>
                        <p class="text-muted mb-1">Copies: @book.AvailableCopies</p>
                    </div>
                }

                <a asp-controller="Home" asp-action="Catalogue" class="btn btn-success btn-sm">
                    View Available
                </a>
            </div>
        </div>

    </div>

</section>


<section class="mt-5">
    <h2 class="section-title">System Features</h2>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="feature-card">
                <h4>Book Management</h4>
                <p>Add, update, view, and manage book records with ISBN, genre, availability, and cover image details.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="feature-card">
                <h4>Library Profiles</h4>
                <p>Manage library name, location, operating hours, and contact information.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="feature-card">
                <h4>Borrowing Records</h4>
                <p>Track borrowed, reserved, returned, and overdue books with return dates and fines.</p>
            </div>
        </div>

        <div class="col-md-3">
            <div class="feature-card">
                <h4>Feedback & Ratings</h4>
                <p>Allow members to submit feedback and ratings for books they have read.</p>
            </div>
        </div>
    </div>
</section>

