@{
    ViewData["Title"] = "Borrowing Guidelines";
}

<div class="dashboard-professional container-fluid">

    <div class="dashboard-header mb-5">
        <h1>Borrowing Guidelines</h1>
        <p>Important rules for borrowing, reservation, renewal, and overdue management.</p>
    </div>

    <div class="row g-4">

        <div class="col-lg-6">
            <div class="dashboard-action-card">
                <div class="dashboard-icon">📚</div>
                <h4>Borrowing Limit</h4>
                <p>Members can borrow up to <strong>5 books</strong> at one time from the KOI Library catalogue.</p>
                <span class="badge bg-primary p-2">Rule</span>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dashboard-action-card">
                <div class="dashboard-icon">📌</div>
                <h4>Reservation Policy</h4>
                <p>Members can reserve unavailable books. Once approved, the reservation status will appear in borrowing records.</p>
                <span class="badge bg-success p-2">Approved</span>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dashboard-action-card">
                <div class="dashboard-icon">⏰</div>
                <h4>Overdue and Fines</h4>
                <p>Borrowed books must be returned before the due date. Overdue books may result in fines according to library rules.</p>
                <span class="badge bg-danger p-2">Important</span>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="dashboard-action-card">
                <div class="dashboard-icon">🔁</div>
                <h4>Renewal Requests</h4>
                <p>Members can request renewal before the due date through the library support section.</p>
                <span class="badge bg-warning text-dark p-2">Notice</span>
            </div>
        </div>

    </div>

</div>