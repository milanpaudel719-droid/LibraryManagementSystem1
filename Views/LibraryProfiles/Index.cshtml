@model IEnumerable<LibraryManagementSystem.Models.LibraryProfile>

@{
    ViewData["Title"] = "Library Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold">Library Information</h1>
        <p class="text-muted">
            View and manage KOI Library branch information and contact details.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add New Library
    </a>

</div>

<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <h3 class="fw-bold text-primary">
                                @item.LibraryName
                            </h3>

                            <p class="text-muted mb-3">
                                📍 @item.Location
                            </p>
                        </div>

                        <span class="badge bg-success">
                            Active
                        </span>

                    </div>

                    <hr />

                    <div class="mb-3">
                        <h6 class="fw-bold">Operating Hours</h6>
                        <p class="text-muted">
                            🕒 @item.OperatingHours
                        </p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold">Contact Information</h6>
                        <p class="text-muted">
                            ✉️ @item.ContactDetails
                        </p>
                    </div>

                    <div class="d-flex gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">
                            Edit
                        </a>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-dark btn-sm">
                            Details
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-danger btn-sm">
                            Delete
                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>