@model IEnumerable<LibraryManagementSystem.Models.BorrowTransaction>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Borrow Transactions";

    var userRole = Context.Session.GetString("UserRole");
    var isAdminOrStaff = userRole == "Admin" || userRole == "Staff";
}

<div class="mb-4">

    <h1 class="fw-bold">Borrow Transactions</h1>

    <p class="text-muted">
        Track borrowed, returned, reserved, and overdue books.
    </p>

</div>

@if (Context.Session.GetString("UserName") == null)
{
    <div class="d-flex justify-content-center align-items-center"
         style="min-height: 350px;">

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary px-4 py-2">
            Login to see the Borrowing Records
        </a>

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered table-hover shadow-sm bg-white">

            <thead class="table-dark">
                <tr>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Borrow Date</th>
                    <th>Return Date</th>
                    <th>Status</th>
                    <th>Fine</th>

                    @if (isAdminOrStaff)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MemberName</td>

                        <td>@item.BookTitle</td>

                        <td>@item.BorrowDate.ToShortDateString()</td>

                        <td>@item.ReturnDate.ToShortDateString()</td>

                        <td>
                            @if (item.Status == "Borrowed")
                            {
                                <span class="badge bg-warning text-dark">Borrowed</span>
                            }
                            else if (item.Status == "Returned")
                            {
                                <span class="badge bg-success">Returned</span>
                            }
                            else if (item.Status == "Reserved")
                            {
                                <span class="badge bg-info text-dark">Reserved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                        </td>

                        <td class="text-danger fw-bold">
                            $@item.FineAmount
                        </td>

                        @if (isAdminOrStaff)
                        {
                            <td>
                                <div class="d-flex gap-2 flex-wrap">

                                    @if (item.Status == "Borrowed")
                                    {
                                        <form asp-action="ReturnBook"
                                              method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm">
                                                Return Book
                                            </button>

                                        </form>
                                    }

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        }
                    </tr>
                }

            </tbody>

        </table>

    </div>
}