@model IEnumerable<LibraryManagementSystem.Models.BorrowTransaction>
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Borrow Transactions";

    var userRole = Context.Session.GetString("UserRole");
    var isAdminOrStaff = userRole == "Admin" || userRole == "Staff";
}

<div class="mb-4">

    <h1 class="fw-bold">Borrow Transactions</h1>

    <p class="text-muted">
        Track borrowed, returned, reserved, renewed, and overdue books.
    </p>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success:</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["BorrowLimitMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Notice:</strong> @TempData["BorrowLimitMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Context.Session.GetString("UserName") == null)
{
    <div class="d-flex justify-content-center align-items-center"
         style="min-height: 350px;">

        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary px-4 py-2">
            Login to see the Borrowing Records
        </a>

    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-bordered table-hover shadow-sm bg-white">

            <thead class="table-dark">
                <tr>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Borrow Date</th>
                    <th>Return Date</th>
                    <th>Renewal</th>
                    <th>Status</th>
                    <th>Fine</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MemberName</td>

                        <td>@item.BookTitle</td>

                        <td>@item.BorrowDate.ToShortDateString()</td>

                        <td>@item.ReturnDate.ToShortDateString()</td>

                        <td>
                            @item.RenewalCount / 1
                        </td>

                        <td>
                            @if (item.Status == "Borrowed")
                            {
                                <span class="badge bg-warning text-dark">Borrowed</span>
                            }
                            else if (item.Status == "Returned")
                            {
                                <span class="badge bg-success">Returned</span>
                            }
                            else if (item.Status == "Reserved")
                            {
                                <span class="badge bg-info text-dark">Reserved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Overdue</span>
                            }
                        </td>

                        <td class="text-danger fw-bold">
                            $@item.FineAmount
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                @if (item.Status == "Borrowed")
                                {
                                    <form asp-action="RenewBook"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-warning btn-sm"
                                                @(item.RenewalCount >= 1 ? "disabled" : "")>
                                            Renew
                                        </button>

                                    </form>
                                }

                                @if (isAdminOrStaff && item.Status == "Borrowed")
                                {
                                    <form asp-action="ReturnBook"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Return Book
                                        </button>

                                    </form>
                                }

                                @if (isAdminOrStaff)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </div>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}